        <!-- Alan Turing -->
        <record id="partner_faculty_alan_turing" model="res.partner">
            <field name="name">Alan Turing</field>
            <field name="email">aturing@school.demo</field>
            <field name="image_1920" type="base64" file="charge_erp_core/static/img/faculty_alan_turing.png"/>
        </record>
        <function model="res.users" name="create" eval="[{
            'name': 'Alan Turing',
            'partner_id': ref('partner_faculty_alan_turing'),
            'login': 'aturing',
            'password': 'demo',
            'groups_id': [(6, 0, [ref('base.group_user'), ref('charge_erp_core.group_op_faculty')])],
        }]" context="{'no_reset_password': True}"/>
        <record id="demo_faculty_alan_turing" model="op.faculty">
            <field name="partner_id" ref="partner_faculty_alan_turing"/>
            <field name="user_id" model="res.users" search="[('login', '=', 'aturing')]"/>
            <field name="first_name">Alan</field>
            <field name="last_name">Turing</field>
            <field name="gender">male</field>
            <field name="birth_date">1912-06-23</field>
            <field name="department_id" ref="demo_department_cs"/>
            <field name="subject_ids" eval="[(6, 0, [ref('demo_subject_cs101'), ref('demo_subject_cs201')])]"/>
        </record>

